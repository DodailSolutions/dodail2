# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent caches
.claude-flow/
.claude/
.agent/

# Local fallback data stores (may contain lead PII and drafts — never commit)
/automation-store.json
/booking-store.json
/cms-content.json
/cms-content-history.json
/cms-store.json
/content-store.json
/crm-store.json
/seo-store.json
