# ==============================================================================
# DODAIL 2.0 ENTERPRISE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# For production deployments (Vercel, AWS, GCP), configure these variables
# directly in your hosting provider's secure Secrets / Environment Settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DOMAIN SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://www.dodail.com
NEXT_PUBLIC_SITE_NAME="Dodail Solutions"

# ------------------------------------------------------------------------------
# 2. SUPABASE (DATABASE, RLS & PERSISTENCE)
# ------------------------------------------------------------------------------
# Project URL (Find in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://cnlhegjvxozidrahjmiz.supabase.co

# Anon Public Key (Safe to expose in browser bundles; governed by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Service Role Secret Key (Server-only; bypasses RLS for background jobs & admin)
# NEVER expose this key in client-side code or public repositories!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 3. AI WEBSITE EMPLOYEE & CONTENT SYNTHESIS (GEMINI / ANTHROPIC)
# ------------------------------------------------------------------------------
# Server-side API key for Google Gemini / Claude models
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-1.5-pro

# ------------------------------------------------------------------------------
# 4. PAYMENT & PAID CONSULTATIONS (RAZORPAY / STRIPE)
# ------------------------------------------------------------------------------
# Mode: "test" or "live"
PAYMENT_GATEWAY_MODE=test

# Razorpay credentials (for INR payments in India)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_signature_secret_here

# Stripe credentials (for International USD / EUR / GBP payments)
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret_here

# ------------------------------------------------------------------------------
# 5. GOOGLE SHEETS & WORKFLOW AUTOMATION
# ------------------------------------------------------------------------------
# Google Cloud Service Account with spreadsheets scope
GOOGLE_SERVICE_ACCOUNT_EMAIL=dodail-automation-sa@dodail-enterprise.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Target Google Spreadsheet ID
DEFAULT_GOOGLE_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms

# ------------------------------------------------------------------------------
# 6. SOCIAL MEDIA PUBLISHING (ENTERPRISE OAUTH)
# ------------------------------------------------------------------------------
# Meta Graph API (Facebook Page & Instagram Business)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here

# LinkedIn Developer API (Company Page Publishing)
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_ORGANIZATION_URN=urn:li:organization:your_organization_id

# ------------------------------------------------------------------------------
# 7. CRON SCHEDULER & DURABLE WORKERS
# ------------------------------------------------------------------------------
# Shared secret for authenticating automated cron triggers (/api/cron/publish)
CRON_SECRET=your_secure_random_cron_secret_token_here

# ------------------------------------------------------------------------------
# 8. OBSERVABILITY & SECURITY CONTROLS
# ------------------------------------------------------------------------------
# Rate limiting threshold per IP (requests per minute)
RATE_LIMIT_PER_MINUTE=60
SSRF_ENFORCEMENT_ENABLED=true
